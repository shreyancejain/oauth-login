# Server
PORT=3000
NODE_ENV=development

# Frontend origin (CORS + post-login redirect). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Must match the callback URL registered on the GitHub OAuth App.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# GitHub OAuth App credentials (https://github.com/settings/developers)
OAUTH_CLIENT_ID=your_github_oauth_app_client_id
OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret

# Used to sign session cookies. Use a long random string (32+ characters).
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Set to true when serving over HTTPS (required outside local HTTP development).
COOKIE_SECURE=false
